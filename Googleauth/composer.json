{
    "name": "webboomers/fossbilling-googleauth",
    "description": "Google login and signup for FOSSBilling (OAuth 2.0 / OpenID Connect, PKCE, secure account linking).",
    "type": "fossbilling-module",
    "license": "MIT",
    "keywords": ["fossbilling", "oauth2", "openid-connect", "google", "authentication", "sso"],
    "homepage": "https://github.com/webboomers/fossbilling-googleauth",
    "support": {
        "issues": "https://github.com/webboomers/fossbilling-googleauth/issues",
        "email": "support@webboomers.in"
    },
    "authors": [
        {
            "name": "Web Boomers",
            "email": "support@webboomers.in",
            "homepage": "https://www.webboomers.in"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Box\\Mod\\Googleauth\\": ""
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Box\\Mod\\Googleauth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
