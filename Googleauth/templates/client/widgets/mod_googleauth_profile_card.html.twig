{#
    Adds a "Google Account" card to the customer's profile page through the
    `client.theme.content.before` widget slot. No core template is modified.
#}
{% if request_path == 'client/profile' and client %}
    {% set googleauth = client.googleauth_status() %}
    {% if googleauth.available %}
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <h5 class="card-title mb-1">{{ 'Google Account'|trans }}</h5>
                        {% if googleauth.connected %}
                            <p class="text-secondary mb-0">
                                {{ 'Status'|trans }}: <strong>{{ 'Connected'|trans }}</strong>
                                {% if googleauth.google_email %}
                                    &middot; {{ googleauth.google_email }}
                                {% endif %}
                            </p>
                        {% else %}
                            <p class="text-secondary mb-0">
                                {{ 'Status'|trans }}: <strong>{{ 'Not connected'|trans }}</strong>
                                &middot; {{ 'Connect Google to sign in without typing your password.'|trans }}
                            </p>
                        {% endif %}
                    </div>
                    <div class="d-flex gap-2">
                        {% if googleauth.connected %}
                            {% if googleauth.can_disconnect %}
                                <a class="btn btn-outline-danger"
                                   {{ fb_api_link({
                                       href: 'googleauth/disconnect'|api_url(role: 'client'),
                                       modal: {type: 'danger', title: 'Disconnect your Google account?'|trans, button: 'Disconnect'|trans},
                                       reload: true
                                   }) }}>{{ 'Disconnect'|trans }}</a>
                            {% else %}
                                <span class="text-secondary small">{{ 'Set a password before disconnecting Google.'|trans }}</span>
                            {% endif %}
                        {% else %}
                            <a class="btn btn-primary" href="{{ googleauth.connect_url }}" rel="nofollow">{{ 'Connect Google Account'|trans }}</a>
                        {% endif %}
                        <a class="btn btn-link" href="{{ 'googleauth/account'|url }}">{{ 'Details'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}
